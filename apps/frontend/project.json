{
  "name": "frontend",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/astro:build",
      "options": {
        "outputPath": "dist/apps/frontend"
      }
    },
    "dev": {
      "executor": "@nx/astro:dev",
      "options": {
        "port": 4321
      }
    },
    "preview": {
      "executor": "@nx/astro:preview",
      "options": {
        "outputPath": "dist/apps/frontend"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/frontend/**/*.{ts,js,astro}"
        ]
      }
    }
  },
  "tags": []
}